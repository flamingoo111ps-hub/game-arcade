# Configuration file for the Game Arcade application
# Copy this file and modify as needed for different environments

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
HOST=127.0.0.1
PORT=5000
THREADS=4

# Game Settings
GAME_MAX_SCORES=100
GAME_DEFAULT_DIFFICULTY=normal

# Features
ENABLE_RECORDS_API=true
ENABLE_STATS_API=true
MAX_CONCURRENT_GAMES=100
